pipeline {
 
   agent {
          docker { 
              image 'ram7800/maven_jdk:v1'
              //args '--user root -v /var/run/docker.sock:/var/run/docker.sock' // mount Docker socket to access the host's Docker daemon
              args '-u 0:0'
            }
      }
  options {
        // Prevents parallel builds from stepping on each other's workspaces
        disableConcurrentBuilds()
    }
  stages {

      stage('Initialize & Clean') {
            steps {
                // Wipe any old workspace leftovers safely at the beginning of the run
                cleanWs(deleteDirs: true)
            }
        }

      stage('Checkout') {
       
        steps {
                // Delete everything using host shell to ensure permissions
                //sh 'rm -rf * .git' 
                cleanWs(deleteDirs: true)
                checkout([$class: 'GitSCM', 
                    branches: [[name: '*/main']], 
                    extensions: [[$class: 'CleanBeforeCheckout']], 
                    userRemoteConfigs: [[url: 'https://github.com/Devops-Raja/spring_boot_app.git']]
                ])
                // Perform checkout inside the container as the correct user
                //checkout([$class: 'GitSCM', branches: [[name: '*/main']], userRemoteConfigs: [[url: 'https://github.com/Devops-Raja/spring_boot_app.git']]])
            }
      }
    
    stage('Build and Test') {

      environment {
        DOCKER_IMAGE = "ram7800/spring_boot_app:${BUILD_NUMBER}"
      }
      steps {
        dir ('java-maven-sonar-argocd-helm-k8s/spring-boot-app'){
          
          sh 'pwd'
          sh 'mvn clean package -U'  
          sh 'ls -lt target/*.jar'

        }
       }
      }
    

    stage('Debug Java') {

     steps {
        sh 'java -version'
        sh 'mvn -version'
      }
    }

    stage('Static Code Analysis') {
      agent { docker { 
        image 'ram7800/maven_jdk:v1'
        //args '-u 105:109'
        args '-u 0:0'
         } }
      environment {
        SONAR_URL = "http://18.60.242.200:9000/"
      }
      steps {
        withCredentials([string(credentialsId: 'sonar', variable: 'SONAR_AUTH_TOKEN')]) {
          
          sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn sonar:sonar -Dsonar.login=$SONAR_AUTH_TOKEN -Dsonar.host.url=${SONAR_URL}'
        }
      }
    }
    stage('Build and Push Docker Image') {
      agent any
      environment {
        DOCKER_IMAGE = "ram7800/spring_boot_app:${BUILD_NUMBER}"
        // DOCKERFILE_LOCATION = "java-maven-sonar-argocd-helm-k8s/spring-boot-app/Dockerfile"
        REGISTRY_CREDENTIALS = credentials('docker_cred')
      }
      steps {
        script {
            sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && docker build -t ${DOCKER_IMAGE} .'
            def dockerImage = docker.image("${DOCKER_IMAGE}")
            docker.withRegistry('https://index.docker.io/v1/', "docker_cred") {
                dockerImage.push()
            }
        }
      }
    }
    stage('Update Deployment File') {
      agent any
      environment {
        GIT_REPO_NAME = "spring_boot_app"
        GIT_USER_NAME = "Devops-Raja"
        }
      steps {
            withCredentials([string(credentialsId: 'git_hub_token', variable: 'GITHUB_TOKEN')]) {
                sh '''
                    git config --global --add safe.directory '*'
                    ##rm -rf .git
                    ##git init
                    git config --global user.email "ram_repo@gmail.com"
                    git config --global user.name "Ram_RR"

                    git remote set-url origin https://${GITHUB_TOKEN}@github.com/Devops-Raja/spring_boot_app.git
                    git fetch origin main
                    git reset --hard origin/main
                    
                    
                    # This searches for the line starting with 'image:' and replaces the value
                    sed -i 's|image: .*|image: ram7800/spring_boot_app:'${BUILD_NUMBER}'|g' java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yaml
                    #sed -i 's|image: .*|image: '${BUILD_NUMBER}'|g' java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yaml
                    #sed -i "s/ImageTag/${BUILD_NUMBER}/g" java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yaml
                    git add java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yaml


                    if git diff-index --cached --quiet HEAD --; then
                       echo "No changes detected. Skipping commit and push."
                    else
                    
            
                    git commit -m "Update deployment image to version ${BUILD_NUMBER}"
                   
                    git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:refs/heads/main
                    fi
                '''
            }
        }
      }
     
     

    } //end of stages 

    post {
        always {
            script {
                echo "Cleaning up workspace..."
                cleanWs(deleteDirs: true)
            }
        }
        success {
            script {
                // Calculate the previous build number
                def previousBuildNumber = (BUILD_NUMBER.toInteger() - 1).toString()
                def previousImage = "ram7800/spring_boot_app:${previousBuildNumber}"
                
                echo "Build successful! Cleaning up previous local image: ${previousImage}"
                
                // Remove the previous image tag if it exists locally
                sh "docker rmi ${previousImage} || true"
                
                // Clean up any untagged/dangling intermediate build layers
                sh "docker image prune -f"
            }
        }
        failure {
            script {
                echo "Build failed! Removing current broken image to save space."
                // If the build fails, clean up the current image immediately since it's broken
                sh "docker rmi ram7800/spring_boot_app:${BUILD_NUMBER} || true"
                sh "docker image prune -f"
            }
        }
    }
  
} //end of pipeline

